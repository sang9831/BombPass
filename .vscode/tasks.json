{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Backend bootRun",
      "type": "shell",
      "command": "./gradlew bootRun",
      "windows": {
        "command": ".\\gradlew.bat bootRun"
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Infra up",
      "type": "shell",
      "command": "docker compose -f infra/compose.yaml up -d",
      "problemMatcher": []
    }
  ]
}
